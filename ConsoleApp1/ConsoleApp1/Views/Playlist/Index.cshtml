@model List<Playlist>

<div class="container mt-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">YouTube Playlists</h2>
            <p class="text-muted mb-0">Welcome, @ViewBag.Username</p>
        </div>

        <div>
            <a asp-action="Create" class="btn btn-primary">Create Playlist</a>
            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-secondary">Logout</a>
        </div>
    </div>

    @foreach (var playlist in Model)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h4 class="card-title">@playlist.Title</h4>
                <p class="text-muted">Created by @playlist.CreatorName</p>

                @if (playlist.Videos.Count == 0)
                {
                    <p class="mb-0">No tracks added.</p>
                }
                else
                {
                    <ol class="mb-0">
                        @foreach (var video in playlist.Videos)
                        {
                            <li class="mb-2">
                                <a href="@video.YouTubeUrl" target="_blank">@video.YouTubeUrl</a>
                                <div class="text-muted">@video.TrackNote</div>
                            </li>
                        }
                    </ol>
                }
            </div>
        </div>
    }
</div>
